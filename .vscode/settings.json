{
    "chat.tools.terminal.autoApprove": {
        "docker rm": true,
        "Out-Null": true,
        "docker run": true,
        ".github/workflows/docker-release.yml": true,
        "ForEach-Object": true,
        "/^python -m compileall app$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}